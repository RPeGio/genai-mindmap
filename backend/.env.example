# 本地开发照抄本文件即演示模式（占位图，不调模型）。
# 注意：代码里的缺省值**不是** demo——完全不设 MINDMAP_LLM_MODE 时，agent 会因
# 缺密钥直接报错，不会静默降级成占位图。要真实模型就改成 model 并填下面三项。
# 密钥不得提交到仓库。此文件不会自动加载，需在启动服务前设置到系统环境变量。
MINDMAP_LLM_MODE=demo
MINDMAP_LLM_BASE_URL=https://example.com/v1
MINDMAP_LLM_API_KEY=
MINDMAP_LLM_MODEL=
# 数据库连接串（PostgreSQL 16）。留空 = 本机 Unix socket 上的 mindmaps 库，
# 与 `app/db/pool.py` 的 `DEFAULT_DSN` 一致；那台机器若走 TCP 就写全串，例如
# postgresql://mindmap:口令@127.0.0.1:5432/mindmaps
# 为什么只有一条串、没有 HOST/PORT/DB/USER/PASSWORD 五个变量：拆开就要处理
# "配了三个漏了两个"的半配置，而 psycopg 的 DSN 本来就能表达全部组合。
# 注意：cookie 的签名密钥从这条串派生，所以**换串会让所有既有登录会话失效一次**。
MINDMAP_PG_DSN=
# 可选：语音转写（百炼 Qwen-Audio-ASR），不配时 .wav 上传返回 422
DASHSCOPE_API_KEY=
# 可选：LibreOffice 的 soffice 路径，处理 .doc / .ppt 等旧格式；不配则从 PATH 找
MINDMAP_SOFFICE_CMD=
# 可选：设为 0 关闭 /api/agent/runs/stream
MINDMAP_AGENT_ENABLED=1
# 可选：引用语义复核（ONNX 模型），默认关闭，只做机械核验
MINDMAP_NLI_ENABLED=0
MINDMAP_NLI_MODEL_DIR=
MINDMAP_NLI_MIN_FREE_MB=
# 可选：知识库检索，默认开。设为 0 时 rag_query 只看本次请求带来的材料，
# 不看知识库（行为与接入知识库之前逐字节相同，便于定位"这条召回是不是库带进来的"）。
# 注意它只影响"生成时捞不捞库"，不影响 GET /api/knowledge/library 的只读入口。
MINDMAP_LIBRARY_SEARCH=1
# 可选：主题生成的外部知识检索，**默认开**。只输一个主题（或材料短到切不出检索
# 单元）时，先去中文维基 / 快懂百科 / arXiv / OpenAlex / Crossref 搜一次，命中的
# 正文转成来源入库，再走既有的 RAG 链路——节点上的引用于是指向真实出处
# （`metadata.url` 在前端可点开）。
# 实测（18 个主题 × 2 轮）：97.2% 能拿到 ≥1 条，中位 4.3 秒、最大 6.5 秒。
# 什么时候会失败：代理没开 / 外网被封（5–6 秒后返回空，退回纯主题生成）、
# 快懂百科在代理下 100% 失败（其余四个源照常）、以及"搜到了但相关性差"
# ——逐字校验只保证引文出自该来源，不保证来源与主题相关，所以 `content` 会明说
# "依据来自外部检索"。
# 关掉它：外网不通的机器上写 0，行为退回"纯主题生成"（不等待、不发请求）。
MINDMAP_EXTERNAL_KNOWLEDGE=1
# 可选：外部检索走的代理。这里填的就是本机 Clash Verge 的 127.0.0.1:7897，
# 也是代码里的兜底值（`DEFAULT_PROXY`）——开发机上照抄这一行正好能通维基。
# **服务器上要改**：那台机器通常没人监听 7897，五个源会全部连不上，而表现只是
# "没搜到外部资料"。服务器上写 `none`（显式直连：只丢维基一条，arXiv /
# OpenAlex / Crossref / 百科 照常可用），或填真实代理地址。
# 留空/删掉这行 = 走兜底去猜 7897，首次检索时会 warning 一次。
# 也认 HTTPS_PROXY / HTTP_PROXY，但**别用它们代替这一行**：那两只是全局的，
# 会被其余九处 httpx 客户端读走（模型调用、ASR、PDF 视觉、embedding、rerank）。
MINDMAP_EXTERNAL_PROXY=http://127.0.0.1:7897
# 可选：把 DeepSeek 的 Search 接成**第六个**外部源，**默认关**。
# 它与上面五个并列而不替换：中文维基对人物/事件更强，Search 对技术方向/流程/方案
# 更强。打开之后一次检索多 1 次请求（0.5–1.1 秒、0.005 元、query 出境到 DeepSeek），
# 换来的是 1 条带正文的命中，占 `limit` 里的 1 个名额（五源仍占其余名额）。
# 为什么默认关：五源已经能覆盖 97.2% 的主题；成本与数据出境应当由你决定。
MINDMAP_EXTERNAL_DEEPSEEK_SEARCH=0
# 可选：粘贴框里贴一个链接 → 按 URL 读成一份材料（POST /api/knowledge/fetch），
# 与 Search 一样**默认关**、一样要 key。关着时贴链接会得到一句"去把开关打开"，
# 而不是一句"抓不到"。
MINDMAP_EXTERNAL_DEEPSEEK_FETCH=0
# 可选：上面两个功能用的 key 与基址。**不填就回落到 MINDMAP_LLM_API_KEY /
# MINDMAP_LLM_BASE_URL**（本仓的 LLM 通道通常就指向 DeepSeek）；LLM 换成别家、
# tools 仍用 DeepSeek 时才需要单独填。基址缺省 https://api.deepseek.com/v1。
MINDMAP_DEEPSEEK_TOOLS_API_KEY=
MINDMAP_DEEPSEEK_TOOLS_BASE_URL=
# 可选：生成时把用到的材料收进知识库，默认开。设为 0 时用完即弃（库里不再新增），
# 与上面那个开关独立——可以先关检索、只留着入库，或者反过来。
MINDMAP_LIBRARY_REMEMBER=1

# 图存储（Neo4j）。密码没有默认值：不填就等于没配置，写接口抛错、读接口返回空。
# 不设 URI/USER/DATABASE 时分别用 bolt://127.0.0.1:7687 / neo4j / neo4j。
MINDMAP_NEO4J_URI=
MINDMAP_NEO4J_USER=
MINDMAP_NEO4J_PASSWORD=
MINDMAP_NEO4J_DATABASE=
