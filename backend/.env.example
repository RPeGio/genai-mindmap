# 本地默认仅提供演示生成；密钥不得提交到仓库。
# 注意：需在启动服务前设置到系统环境变量。此文件不会自动加载。
MINDMAP_LLM_MODE=demo
MINDMAP_LLM_BASE_URL=https://example.com/v1
MINDMAP_LLM_API_KEY=
MINDMAP_LLM_MODEL=
# 可选：SQLite 文件路径（默认 backend/data/mindmaps.db）
MINDMAP_DB_PATH=
# 可选：语音转写（百炼 Qwen-Audio-ASR），不配时 .wav 上传返回 422
DASHSCOPE_API_KEY=
# 可选：LibreOffice 的 soffice 路径，处理 .doc / .ppt 等旧格式；不配则从 PATH 找
MINDMAP_SOFFICE_CMD=
# 可选：设为 0 关闭 /api/agent/runs/stream
MINDMAP_AGENT_ENABLED=1
# 可选：引用语义复核（ONNX 模型），默认关闭，只做机械核验
MINDMAP_NLI_ENABLED=0
MINDMAP_NLI_MODEL_DIR=
MINDMAP_NLI_MIN_FREE_MB=
