data/
uploads/
exports/
eval/results/
eval/reports/

# Python development
.venv/
__pycache__/
.pytest_cache/
*.py[cod]
*.db
# 覆盖率产物：pytest-cov 每次运行都会重写，不该进仓库
.coverage
.coverage.*
coverage.xml
htmlcov/

# AI Agent contracts
# 规范要共享才有效：AGENTS.md 落到仓库里，两个人看到的才是同一份。
# 各人的本地覆盖走 AGENTS.local.md（仍在忽略范围）。
AGENTS.md
!AGENTS.md
AGENTS.local.md
*.gz

# codex 派活脚本的产物：报告与事件流都属于一次性排障材料
codex-report-*.md
codex-raw-*.log

# 真浏览器验证的临时目录（截图、种子脚本、对比脚本）。产物值得留，但不该进版本库
.visioncheck/

# 鱼骨几何的一次性验证脚本与截图（.visioncheck 的兄弟目录，同样不进版本库）
frontend/verify-fishbone.html
frontend/verify-fishbone.ts
frontend/verify-shots/

# 本地启动脚本：里面是真实的 API key（DeepSeek + 阿里 MaaS）。
# 启动方式见文件本身；要给别人用就照 .env.example 另写一份带占位符的。
run-backend.bat

# 容器版设置面板的 Basic Auth 密码文件（`htpasswd -c docker/.htpasswd admin`）。
# 它里面是密码哈希，和 `.env` 同一类东西。compose 把这个路径**只读挂载**进
# nginx 容器，不进镜像，也不该进版本库——提交一次就等于把这个面板的口令
# 发给所有能读仓库的人。
.htpasswd
**/.htpasswd
